// RRMS database schema. The connection URL lives in prisma.config.ts.
//
// Constraints Prisma cannot express are added by hand in the migration SQL:
// - btree_gist extension
// - CHECK "endAt" > "startAt" and CHECK capacity > 0
// - EXCLUDE USING gist: no two CONFIRMED reservations for the same resource may overlap.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum ResourceType {
  MEETING_ROOM
  EQUIPMENT
  VEHICLE
  LAB
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  reservations Reservation[]
}

model Resource {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  type         ResourceType
  location     String
  capacity     Int
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  reservations Reservation[]
}

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @db.Uuid
  resourceId String            @db.Uuid
  // Half-open interval [startAt, endAt): a booking may start exactly when another ends.
  startAt    DateTime          @db.Timestamptz(3)
  endAt      DateTime          @db.Timestamptz(3)
  status     ReservationStatus @default(CONFIRMED)
  purpose    String?
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)

  // Restrict: users/resources with booking history cannot be deleted (resources are deactivated instead).
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@index([userId, startAt])
  @@index([resourceId, startAt])
}
