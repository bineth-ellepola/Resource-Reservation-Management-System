# Copy to .env and replace the placeholders. Never commit .env.
# Percent-encode special characters in passwords (e.g. "@" becomes "%40").

# Application database (owned by the rrms_app role).
DATABASE_URL="postgresql://rrms_app:YOUR_PASSWORD@localhost:5432/rrms_db?schema=public"

# Separate database for integration tests; tests truncate its tables.
TEST_DATABASE_URL="postgresql://rrms_app:YOUR_PASSWORD@localhost:5432/rrms_test?schema=public"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_VALUE"
